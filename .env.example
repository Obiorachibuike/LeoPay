# ---------------------------------------------------------------------------
# LeoPay environment configuration
# Copy to .env.local and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# Public base URL, used in emails, redirects and webhook docs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LeoPay

# --- Database ---------------------------------------------------------------
# Leave both unset for the embedded PGlite database (local development only).
# Production MUST use a managed PostgreSQL instance.
# DB_DRIVER=postgres
# DATABASE_URL=postgres://user:password@host:5432/leopay?sslmode=require
# PGLITE_DIR=.data/pglite

# --- Security ---------------------------------------------------------------
# 32+ random characters: openssl rand -base64 48
# Generate one with: openssl rand -base64 48
AUTH_SECRET=
# Encrypts beneficiary account numbers at rest. 32+ random characters.
# Generate one with: openssl rand -base64 48
WEBHOOK_ENCRYPTION_KEY=
SESSION_TTL_DAYS=30

# --- Payments ---------------------------------------------------------------
# mock = simulated payments for development only. In production a non-mock
# provider is required unless ALLOW_MOCK_PAYMENTS=true (demos only).
PAYMENT_PROVIDER=mock
# PAYSTACK_SECRET_KEY=          # from your Paystack dashboard
# PAYSTACK_PUBLIC_KEY=
# ALLOW_MOCK_PAYMENTS=false

# --- Email ------------------------------------------------------------------
# log = writes emails to the notifications table without sending them.
EMAIL_PROVIDER=log
EMAIL_FROM=LeoPay <no-reply@example.com>
# EMAIL_API_KEY=               # from your email provider dashboard
# EMAIL_API_BASE=https://api.resend.com

# --- Background jobs --------------------------------------------------------
# In-process ticker for local development / a single server node.
ENABLE_INLINE_JOBS=true
# Bearer token for POST /api/cron (set a long random value in production).
JOB_RUNNER_TOKEN=

# --- Optional ---------------------------------------------------------------
# Comma-separated extra origins allowed to invoke server actions.
ALLOWED_ORIGINS=
TRUST_PROXY=true
LOG_LEVEL=info
# Local demo sign-in endpoint (never enable in production).
ENABLE_DEV_LOGIN=false
# Seed credentials (development only).
# SEED_EMAIL=demo@leopay.test
# SEED_PASSWORD=change-me-in-local-env
