{
  "name": "leopay",
  "version": "1.0.0",
  "private": true,
  "description": "LeoPay - business payments platform for Nigerian businesses",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "TEST_DATABASE_URL=postgresql://leopay:leopay@localhost:5432/leopay_test vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db && npm run db:migrate",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "check": "npm run typecheck && npm run lint && npm run test",
    "dev:session": "tsx --conditions=react-server scripts/dev-session.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "0.475.0",
    "next": "15.5.28",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.1.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "3.2.7"
  }
}
